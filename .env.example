# Database
DATABASE_URL=postgresql+psycopg://call_manager:call_manager@localhost:5432/call_manager

# Web / session
SESSION_SECRET=change-me-to-a-long-random-string

# Auth
ALLOWED_EMAIL_DOMAINS=karolinska.se,regionstockholm.se,ki.se
INITIAL_ADMIN_EMAIL=

# Email (Resend for v1; swap to SMTP later if needed)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
APP_BASE_URL=http://localhost:8000

# LLM (placeholders — ranking plan wires these up)
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e4b-it-q4_K_M

# Ingestion
EU_PORTAL_BASE_URL=https://ec.europa.eu
VINNOVA_BASE_URL=https://data.vinnova.se
# Optional: receive consecutive-failure alerts here. Leave blank to suppress.
ADMIN_ALERT_EMAIL=

# Foundation review-fixes added this but didn't document it; documenting now.
# When true, the rate limiter keys off X-Forwarded-For instead of the
# socket peer. Only set TRUSTED_PROXY=true when the app sits behind a
# proxy you control end-to-end (otherwise a client can spoof the header
# and bypass rate limiting).
TRUSTED_PROXY=false

# Ranking worker cadence
RANKING_TICK_SECONDS=60
RANKING_QUEUE_BATCH=10

# ─────────────────────────────────────────────────────────────────────
# Proposal-assist (B3 + B4 + B5 + B6)
# ─────────────────────────────────────────────────────────────────────

# Anthropic API key for the drafting agent (Claude Opus 4.7 via the
# Agent SDK). Leave blank in dev to use DRAFTING_ADAPTER=fake.
ANTHROPIC_API_KEY=

# Filesystem root for per-workspace git repos. Each workspace gets
# var/workspaces/<uuid>/repo/. Must be writable, backed up, excluded
# from the docker image.
WORKSPACES_DIR=var/workspaces

# Which DraftingAgent implementation to wire up.
#   "claude" — real ClaudeAgentSDKAdapter (requires ANTHROPIC_API_KEY).
#   "fake"   — FakeAgentAdapter (for integration tests + local demos
#              without an API key).
DRAFTING_ADAPTER=claude

# Model the drafting subprocess + compaction summarizer use. Also used
# by some extractors. Must be a model the SDK recognizes.
PROPOSAL_ASSIST_LLM_MODEL=claude-opus-4-7

# Extractor versions — bump these when changing the corresponding
# extractor prompt or output schema. Phase 0 reads these to decide
# whether stored extracts are stale and must be re-extracted. Without
# bumping, an operator changing the prompt would silently get stale
# extracts on existing workspaces.
EXTRACTOR_VERSION=sections-v1
RUBRIC_EXTRACTOR_VERSION=rubric-v1

# Per-workspace drafting subprocess lifecycle.
# Idle timeout = how long a subprocess sits with no turns before the
# sweep evicts it. Lower = less idle memory; higher = fewer cold starts.
WORKSPACE_IDLE_TIMEOUT_SECONDS=600
# Sweep cadence — how often the scheduler asks the registry to check
# for idle subprocesses. Faster sweep = tighter teardown latency, more
# polling. Defaults to once per minute.
WORKSPACE_IDLE_SWEEP_SECONDS=60

# Per-workspace daily token caps (Europe/Stockholm day boundary).
# Overridable per-workspace via workspaces.daily_token_cap_{in,out}_override.
# Enforced pre-enqueue by submit_user_turn(); over-cap returns 429.
DAILY_TOKEN_CAP_INPUT=500000
DAILY_TOKEN_CAP_OUTPUT=100000

# Compaction (bounded-replay summarization) thresholds + cadence.
# COMPACTION_TURN_THRESHOLD — number of un-summarized chat_turns since
#   the latest chat_summaries row that triggers compaction.
# COMPACTION_TOKEN_THRESHOLD — sum of input-tokens across un-summarized
#   chat_turns that triggers compaction (whichever trips first).
# COMPACTION_TICK_SECONDS — how often the compaction tick scans for
#   workspaces over threshold.
COMPACTION_TURN_THRESHOLD=100
COMPACTION_TOKEN_THRESHOLD=200000
COMPACTION_TICK_SECONDS=300

# Turn-drain tick cadence. Lower = snappier perceived latency; higher =
# less polling overhead. B6's SSE bridge also polls at 200 ms but does
# not kick the drain tick directly, so this is the floor on turn
# pickup time.
TURN_DRAIN_TICK_SECONDS=5

# Phase 0 (workspace setup worker) tick cadence — drains workspace_setup_jobs.
PHASE0_TICK_SECONDS=30
