# .env.example — GENERATED from src/call_manager/config.py by
# scripts/gen_env_example.py. Do not hand-edit: regenerate with
#     uv run python scripts/gen_env_example.py
# and tests/test_env_example.py fails while this file is stale.
#
# Copy to .env. Lines that are NOT commented out are the day-one decisions
# (required values, and defaults a real deployment must confirm); commented
# lines show the code default and can be left alone. Every setting the app
# reads is listed, in the order config.py declares it.


# DATABASE_URL (REQUIRED)
# SQLAlchemy URL of the Postgres 16 database (psycopg driver), e.g.
# postgresql+psycopg://call_manager:PASSWORD@localhost:5432/call_manager.
# Alembic reads the same value (alembic/env.py falls back to this file).
DATABASE_URL=postgresql+psycopg://call_manager:CHANGE_ME@localhost:5432/call_manager

# SESSION_SECRET (REQUIRED)
# Signing key for the session cookie. Generate one: python -c "import secrets;
# print(secrets.token_urlsafe(48))". Left blank in the example on purpose so a
# copied file cannot ship a known key; with an https:// APP_BASE_URL the app
# refuses to start unless it is >= 32 chars and not a known dev placeholder.
SESSION_SECRET=

# ALLOWED_EMAIL_DOMAINS (REQUIRED)
# Comma-separated email domains allowed to sign in or request access.
ALLOWED_EMAIL_DOMAINS=regionvasterbotten.se,umu.se

# INITIAL_ADMIN_EMAIL (default: empty)
# Comma-separated admin emails created at startup. Lockout recovery: when NO
# active admin exists, these are re-activated and re-promoted at startup —
# otherwise an existing user is left exactly as it is. To permanently demote
# one, remove it from this list first.
INITIAL_ADMIN_EMAIL=

# INITIAL_ADMIN_PASSWORD (default: empty)
# Password for a configured admin that does NOT have one yet (first boot, or
# an admin restored from total lockout). Must be >= 12 chars; empty = unset.
# It never overwrites an existing password hash (admin_bootstrap.py): a
# restart with this set does not reset a forgotten or compromised admin
# password — use the in-app admin reset, which needs a second admin. Unset it
# once logged in so the value stops living in a file.
# INITIAL_ADMIN_PASSWORD=

# APP_BASE_URL (REQUIRED)
# The origin browsers use, scheme included, no path. It is what the CSRF and
# WebSocket origin checks compare against, so in SPA_MODE=dev it is the Vite
# origin (http://localhost:5173); https:// switches on the production checks.
APP_BASE_URL=https://calls.example.org

# GOOGLE_OIDC_ENABLED (default: false)
#
# GOOGLE_OIDC_ENABLED=false

# GOOGLE_CLIENT_ID (default: empty)
#
# GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET (default: empty)
#
# GOOGLE_CLIENT_SECRET=

# GOOGLE_OIDC_DISCOVERY_URL (default: https://accounts.google.com/.well-known/openid-configuration)
#
# GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# RESEND_API_KEY (default: empty)
#
RESEND_API_KEY=

# EMAIL_FROM (default: no-reply@example.com)
#
EMAIL_FROM=no-reply@example.com

# TRUSTED_PROXY (default: false)
#
TRUSTED_PROXY=false

# TRUSTED_PROXY_HOPS (default: 1)
#
TRUSTED_PROXY_HOPS=1

# EU_PORTAL_BASE_URL (default: https://ec.europa.eu)
#
# EU_PORTAL_BASE_URL=https://ec.europa.eu

# VINNOVA_BASE_URL (default: https://data.vinnova.se)
#
# VINNOVA_BASE_URL=https://data.vinnova.se

# ADMIN_ALERT_EMAIL (default: empty)
#
ADMIN_ALERT_EMAIL=

# STALE_SOURCE_ALERT_DAYS (default: 4)
# A source whose last_fetched_at is older than this many days triggers a
# stale-fetch alert regardless of the consecutive-failure streak state. Acts
# as a restart-independent backstop: catches sources that silently stop being
# fetched (e.g. scheduler crash within the 3-day streak window). Default 4
# gives one full day of slack beyond the 3-day streak threshold.
STALE_SOURCE_ALERT_DAYS=4

# RANKING_TICK_SECONDS (default: 60)
#
# RANKING_TICK_SECONDS=60

# RANKING_QUEUE_BATCH (default: 10)
#
# RANKING_QUEUE_BATCH=10

# RANKING_TICK_BUDGET_SECONDS (default: 240.0)
#
# RANKING_TICK_BUDGET_SECONDS=240.0

# OLLAMA_URL (default: http://localhost:11434)
#
OLLAMA_URL=http://localhost:11434

# GEMMA_MODEL (default: gemma4:e4b-it-q4_K_M)
#
GEMMA_MODEL=gemma4:e4b-it-q4_K_M

# EMBEDDING_MODEL (default: bge-m3)
# Ollama embedding model (1024-dim). Must match what Ollama has pulled; the
# similarity thresholds are calibrated for bge-m3.
EMBEDDING_MODEL=bge-m3

# EMBEDDING_DIM (default: 1024)
#
# EMBEDDING_DIM=1024

# EMBEDDING_PREGATE_THRESHOLD (default: 0.3)
#
# EMBEDDING_PREGATE_THRESHOLD=0.3

# EMBEDDING_HARD_FAIL_THRESHOLD (default: 0.2)
#
# EMBEDDING_HARD_FAIL_THRESHOLD=0.2

# ANTHROPIC_API_KEY (default: empty)
#
ANTHROPIC_API_KEY=

# DRAFTING_ENABLED (default: true)
# Kill switch for the proposal-assist drafting subsystem. When False, POST
# /workspaces/<id>/turns returns 503 and the drain tick is a no-op (queued
# turns wait for re-enable). Toggle requires app restart; UI-driven toggling
# is deferred.
DRAFTING_ENABLED=false

# APP_EDITION (default: full)
# Which product edition this process serves. 'match' is Call Match release 1:
# funding-call matching only. It does NOT mount the proposal-assist routers
# (workspaces, turns, annotations, rubric, references, citation_audit, export,
# files) or the collab websocket, so those endpoints do not exist rather than
# returning 403. 'full' is the complete application. This is a deploy-time
# decision, not a runtime toggle; the frontend has a matching build flag
# (VITE_APP_EDITION) and the two must agree. A 'match' process REQUIRES
# DRAFTING_ENABLED=false and refuses to start otherwise.
# APP_EDITION=full

# EXTRACTOR_VERSION (default: sections-v1)
# Bump when the section extractor prompt or output schema changes; stored on
# call_section_extracts.extractor_version and used by Phase 0 to decide
# whether to re-extract.
# EXTRACTOR_VERSION=sections-v1

# RUBRIC_EXTRACTOR_VERSION (default: rubric-v1)
# Bump when the rubric extractor prompt or output schema changes.
# RUBRIC_EXTRACTOR_VERSION=rubric-v1

# PROPOSAL_ASSIST_LLM_MODEL (default: claude-opus-5)
# Anthropic model id used for proposal-assist extractors,
# score_against_rubric, fit-check, persona scoring, and consolidation.
PROPOSAL_ASSIST_LLM_MODEL=claude-opus-5

# PHASE0_TICK_SECONDS (default: 30)
# How often the in-process Phase 0 worker drains workspace_setup_jobs.
# Lowering this shortens the gap between workspace creation and rubric-review
# prompt; raising it reduces idle DB churn when the queue is empty.
# PHASE0_TICK_SECONDS=30

# PASSES_RECONCILE_TICK_SECONDS (default: 60)
# How often to retry teardown for pass generations whose death was never
# confirmed. A sibling of reconcile_live_clients for a population it does not
# cover (one-shot per-pass adapters). Independent of DRAFTING_ENABLED.
# PASSES_RECONCILE_TICK_SECONDS=60

# JOBS_RECONCILE_TICK_SECONDS (default: 60)
# How often to converge job rows the retirement hook skipped because a live
# worker held them. Independent of DRAFTING_ENABLED — a deployment with
# drafting off must still terminalize a deleted workspace's jobs.
# JOBS_RECONCILE_TICK_SECONDS=60

# PROFILE_BOOTSTRAP_TICK_SECONDS (default: 30)
# How often the in-process profile bootstrap worker drains
# profile_bootstrap_jobs. Lowering this shortens the gap between profile
# creation and LLM draft completion; raising it reduces idle DB churn when the
# queue is empty.
# PROFILE_BOOTSTRAP_TICK_SECONDS=30

# WORKSPACES_DIR (default: var/workspaces)
# Filesystem root for per-workspace git repos. Each workspace gets
# var/workspaces/<uuid>/repo/. Must be writable, backed up, excluded from the
# docker image.
WORKSPACES_DIR=var/workspaces

# DRAFTING_ADAPTER (default: claude)
# Which DraftingAgent implementation to wire up. 'claude' (default) →
# ClaudeAgentSDKAdapter; 'fake' → FakeAgentAdapter (for integration tests +
# local demos without an API key).
DRAFTING_ADAPTER=claude

# DRAFTING_MAX_LIVE_SUBPROCESSES (default: 8)
# Hard ceiling on concurrent live drafting subprocesses (Defect 1
# remediation). Each live subprocess pins ONE pooled DB connection for its
# lifetime (the session-level advisory lock keeps it checked out, up to
# WORKSPACE_IDLE_TIMEOUT_SECONDS). Keep this well below the engine pool
# (pool_size=10 + max_overflow=20 = 30) so drafting can never starve
# web/scheduler connections. In production those lock sessions come from a
# DEDICATED engine (DRAFTING_DB_POOL_SIZE) sized to this ceiling, so they
# don't draw on the request pool at all. At the cap, a new launch evicts the
# least-recently-used IDLE handle; if all are mid-turn, it returns a retriable
# 429.
DRAFTING_MAX_LIVE_SUBPROCESSES=8

# DRAFTING_DB_POOL_SIZE (default: 8)
# pool_size for the DEDICATED engine that backs drafting advisory-lock
# sessions, isolating long-held drafting connections from the
# request/scheduler engine. Size it to DRAFTING_MAX_LIVE_SUBPROCESSES (+1 head
# room for the brief launch overlap during LRU eviction). max_overflow is 1 so
# the pool can't silently exceed the ceiling.
DRAFTING_DB_POOL_SIZE=8

# WORKSPACE_IDLE_TIMEOUT_SECONDS (default: 600)
# Seconds of inactivity after which a drafting subprocess is torn down. The
# next user turn relaunches it (with resume-from-history). Lower = less idle
# memory; higher = fewer cold starts on bursty usage.
# WORKSPACE_IDLE_TIMEOUT_SECONDS=600

# WORKSPACE_IDLE_SWEEP_SECONDS (default: 60)
# Cadence at which the scheduler asks the subprocess registry to sweep handles
# idle for WORKSPACE_IDLE_TIMEOUT_SECONDS or longer. Faster sweep = tighter
# teardown latency but more polling.
# WORKSPACE_IDLE_SWEEP_SECONDS=60

# COLLAB_CHECKPOINT_SCAN_SECONDS (default: 60)
# Interval for the collab tail-bounding scan (Slice 3b-5c). 0 disables the
# periodic job entirely.
# COLLAB_CHECKPOINT_SCAN_SECONDS=60

# COLLAB_CHECKPOINT_MIN_TAIL (default: 200)
# Min uncheckpointed Yjs-log rows before a collab room is auto-checkpointed.
# COLLAB_CHECKPOINT_MIN_TAIL=200

# SCHEDULER_STANDBY_OK (default: false)
# This app is single-instance: the in-process scheduler, the collab room
# manager, the drafting registry and the login limiters are all per-process
# state. When another process already holds the single-instance advisory lock,
# startup is FATAL by default. Set true to boot an HTTP-only standby instead:
# it serves requests, runs no scheduler, and /healthz reports
# scheduler_lock=false.
# SCHEDULER_STANDBY_OK=false

# COLLAB_KILL_SWITCH (default: false)
# Emergency brake (3b-5d.D4): when true, is_collab_enabled reports False
# everywhere (WS refuses, writers take git-first branches, reads fall back to
# git, auto-enable pauses) and startup runs the drain-then-truncate handover
# pass, making git the sole canonical store. Engage by setting the env and
# RESTARTING — the restart is the socket drain. enabled_at rows are never
# cleared.
COLLAB_KILL_SWITCH=false

# RETENTION_INSPECTION_ENABLED (default: false)
# Whether an admin may READ a soft-deleted workspace's surviving draft text
# and commit history (GET /api/admin/workspaces/deleted/{id}). Default False:
# that content is a researcher's unpublished proposal, deletion is the signal
# they wanted it gone, and no deployment should expose it because nobody chose
# otherwise. Deliberately does NOT gate the LIST endpoint — titles, owners and
# deletion times are what an admin needs to manage retention and to decide
# what to purge, and gating those would make the retention surface useless
# rather than private. The split is the point: see what exists without reading
# it.
RETENTION_INSPECTION_ENABLED=false

# DAILY_TOKEN_CAP_INPUT (default: 500000)
# Per-workspace default daily input-token cap (Europe/Stockholm day).
# Overridable per-workspace via workspaces.daily_token_cap_in_override.
# Enforced pre-enqueue by submit_user_turn(); B8 will surface the UX.
# DAILY_TOKEN_CAP_INPUT=500000

# DAILY_TOKEN_CAP_OUTPUT (default: 100000)
# Per-workspace default daily output-token cap.
# DAILY_TOKEN_CAP_OUTPUT=100000

# GLOBAL_DAILY_TOKEN_CAP_INPUT (default: 5000000)
# Org-wide ceiling on total input tokens (sum across all workspaces) per
# Europe/Stockholm day. Defaults to 10x the per-workspace cap so a single
# runaway workspace can't bill the whole budget. Enforced before per-workspace
# cap; a small overshoot from concurrent submits is acceptable (guardrail, not
# exact ledger).
# GLOBAL_DAILY_TOKEN_CAP_INPUT=5000000

# GLOBAL_DAILY_TOKEN_CAP_OUTPUT (default: 1000000)
# Org-wide ceiling on total output tokens (sum across all workspaces) per
# Europe/Stockholm day. Defaults to 10x the per-workspace cap.
# GLOBAL_DAILY_TOKEN_CAP_OUTPUT=1000000

# COHERENCE_DAILY_TOKEN_CAP (default: 200000)
# Per-workspace daily ceiling on combined input+output tokens spent by
# coherence-keeper passes (Europe/Stockholm day). A pass is blocked pre-run
# once today's coherence_jobs token sum reaches this cap. The other coherence
# settings land in SP2b-2c Task 7.
# COHERENCE_DAILY_TOKEN_CAP=200000

# COHERENCE_PASS_TIMEOUT_SECONDS (default: 180)
# In-pass asyncio.wait_for bound on the keeper SDK turn. On timeout the one-
# shot adapter is terminated and the job is failed.
# COHERENCE_PASS_TIMEOUT_SECONDS=180

# COHERENCE_TICK_SECONDS (default: 20)
# How often the coherence drain tick claims+runs one queued coherence pass.
# Manual-only, so this just bounds latency from click to run.
# COHERENCE_TICK_SECONDS=20

# COHERENCE_JOB_TIMEOUT_SECONDS (default: 300)
# Reaper TTL (age cutoff): a running coherence job older than this is failed
# (crash/restart recovery), unwedging the workspace's active-unique slot.
# COHERENCE_JOB_TIMEOUT_SECONDS=300

# COHERENCE_REAPER_TICK_SECONDS (default: 60)
# How often the reaper sweep RUNS (decoupled from the TTL age cutoff above).
# Keeping this below coherence_job_timeout_seconds caps worst-case unwedge
# after a crash at ~TTL + this interval, rather than ~2x TTL when the two are
# equal.
# COHERENCE_REAPER_TICK_SECONDS=60

# COHERENCE_TERMINATE_TIMEOUT_SECONDS (default: 30)
# In-pass asyncio.wait_for bound on the one-shot keeper adapter's terminate()
# cleanup. A hung SDK disconnect must not leak the pass coroutine; kept well
# under the scheduler's coherence_pass_timeout_seconds+60 future grace.
# COHERENCE_TERMINATE_TIMEOUT_SECONDS=30

# EVALUATOR_TICK_SECONDS (default: 20)
# How often the evaluator drain tick claims+runs one queued evaluator pass.
# Manual-only, so this just bounds latency from click to run.
# EVALUATOR_TICK_SECONDS=20

# EVALUATOR_PASS_TIMEOUT_SECONDS (default: 180)
# In-pass asyncio.wait_for bound on the evaluator SDK turn (launch+drive). On
# timeout the one-shot adapter is terminated and the job is failed.
# EVALUATOR_PASS_TIMEOUT_SECONDS=180

# EVALUATOR_JOB_TIMEOUT_SECONDS (default: 300)
# Reaper TTL (age cutoff): a running evaluator job older than this is failed
# (crash/restart recovery), unwedging the workspace's active-unique slot.
# EVALUATOR_JOB_TIMEOUT_SECONDS=300

# EVALUATOR_REAPER_TICK_SECONDS (default: 60)
# How often the evaluator reaper sweep RUNS (decoupled from the TTL age cutoff
# above), capping worst-case unwedge at ~TTL + this interval.
# EVALUATOR_REAPER_TICK_SECONDS=60

# EVALUATOR_TERMINATE_TIMEOUT_SECONDS (default: 30)
# In-pass asyncio.wait_for bound on the one-shot evaluator adapter's
# terminate() cleanup. A hung SDK disconnect must not leak the pass coroutine.
# EVALUATOR_TERMINATE_TIMEOUT_SECONDS=30

# EVALUATOR_DAILY_TOKEN_CAP (default: 200000)
# Per-workspace daily ceiling on combined input+output tokens spent by
# evaluator passes (Europe/Stockholm day). A pass is blocked pre-run once
# reached.
# EVALUATOR_DAILY_TOKEN_CAP=200000

# UNCITED_CLAIMS_TICK_SECONDS (default: 20)
# How often the uncited-claims drain tick claims+runs one queued pass. Manual-
# only, so this just bounds latency from click to run.
# UNCITED_CLAIMS_TICK_SECONDS=20

# UNCITED_CLAIMS_PASS_TIMEOUT_SECONDS (default: 180)
# In-pass asyncio.wait_for bound on the uncited-claims SDK turn
# (launch+drive). On timeout the one-shot adapter is terminated and the job is
# failed.
# UNCITED_CLAIMS_PASS_TIMEOUT_SECONDS=180

# UNCITED_CLAIMS_JOB_TIMEOUT_SECONDS (default: 300)
# Reaper TTL: a running uncited-claims job older than this is failed
# (crash/restart recovery), unwedging the workspace's active-unique slot.
# UNCITED_CLAIMS_JOB_TIMEOUT_SECONDS=300

# UNCITED_CLAIMS_REAPER_TICK_SECONDS (default: 60)
# How often the uncited-claims reaper sweep RUNS (decoupled from the TTL).
# UNCITED_CLAIMS_REAPER_TICK_SECONDS=60

# UNCITED_CLAIMS_TERMINATE_TIMEOUT_SECONDS (default: 30)
# In-pass asyncio.wait_for bound on the one-shot adapter's terminate()
# cleanup. A hung SDK disconnect must not leak the pass coroutine.
# UNCITED_CLAIMS_TERMINATE_TIMEOUT_SECONDS=30

# UNCITED_CLAIMS_DAILY_TOKEN_CAP (default: 200000)
# Per-workspace daily ceiling on combined input+output tokens spent by
# uncited-claims passes (Europe/Stockholm day). A pass is blocked pre-run once
# reached.
# UNCITED_CLAIMS_DAILY_TOKEN_CAP=200000

# REVIEW_TICK_SECONDS (default: 20)
# How often the review drain tick claims+runs one queued mock-panel run.
# REVIEW_TICK_SECONDS=20

# REVIEW_PERSONA_TIMEOUT_SECONDS (default: 180)
# Per sub-call asyncio.wait_for bound (launch+drive) on each persona / fit-
# check / consolidation SDK turn.
# REVIEW_PERSONA_TIMEOUT_SECONDS=180

# REVIEW_JOB_TIMEOUT_SECONDS (default: 900)
# Reaper TTL: a running review run older than this (by triggered_at) is failed
# (crash recovery), unwedging the active-unique slot. The whole 6-call fan-out
# must fit well under this.
# REVIEW_JOB_TIMEOUT_SECONDS=900

# REVIEW_REAPER_TICK_SECONDS (default: 60)
# How often the review reaper sweep runs (decoupled from the TTL above).
# REVIEW_REAPER_TICK_SECONDS=60

# REVIEW_TERMINATE_TIMEOUT_SECONDS (default: 30)
# Per sub-call asyncio.wait_for bound on each one-shot adapter's terminate().
# REVIEW_TERMINATE_TIMEOUT_SECONDS=30

# REVIEW_PERSONA_CONCURRENCY (default: 3)
# Max simultaneous wave-1 sub-calls (fit-check + 4 personas) within one run.
# Must be >= 1: asyncio.Semaphore(0) would deadlock the fan-out until the
# reaper TTL.
# REVIEW_PERSONA_CONCURRENCY=3

# REVIEW_RUNS_PER_DAY_DEFAULT (default: 5)
# Global per-workspace daily cap on mock-panel runs (Europe/Stockholm day);
# overridable per workspace via Workspace.review_runs_per_day_override.
REVIEW_RUNS_PER_DAY_DEFAULT=5

# REVIEW_DOLLAR_CAP_DEFAULT (default: 5.000)
# Global per-workspace daily $ cap on mock-panel runs; overridable per
# workspace via Workspace.review_dollar_cap_override.
REVIEW_DOLLAR_CAP_DEFAULT=5.000

# REVIEW_PRICE_INPUT_PER_MTOK (default: 5.00)
# Input price per 1M tokens for proposal_assist_llm_model (cache-read is
# bundled into tokens_in by the adapter and priced at this rate, which
# OVERSTATES it — a cache hit really costs 0.1x input). $5.00 covers Opus 4.5
# through Opus 5, which all share this rate; re-check against the pricing page
# when changing the model.
# REVIEW_PRICE_INPUT_PER_MTOK=5.00

# REVIEW_PRICE_OUTPUT_PER_MTOK (default: 25.00)
# Output price per 1M tokens for proposal_assist_llm_model. $25.00 covers Opus
# 4.5 through Opus 5, which all share this rate.
# REVIEW_PRICE_OUTPUT_PER_MTOK=25.00

# PROBLEM_SECTION_CHAR_BUDGET (default: 6000)
# Per-section character budget for the Problems panel's over-length heuristic
# (draft sections only). A loose guardrail, not a hard funder limit; a value
# <= 0 disables the over-length check.
# PROBLEM_SECTION_CHAR_BUDGET=6000

# CITATION_DEEP_CHECK_MAX_PER_REQUEST (default: 25)
# Maximum number of FRESH (uncached) semantic LLM calls made per POST
# /citation-audit/deep request. Already-cached verdicts are returned without
# counting against this ceiling. Rows beyond the cap are deferred and reported
# in the response so the client can re-poll to continue. Default 25 keeps a
# single request well within a synchronous HTTP timeout budget.
# CITATION_DEEP_CHECK_MAX_PER_REQUEST=25

# CITATION_LLM_PROVIDER (default: ollama)
#
CITATION_LLM_PROVIDER=ollama

# CITATION_LLM_ALLOW_CLOUD (default: false)
# Operator opt-in for sending citation/reference text off-prem.
# CITATION_LLM_PROVIDER=anthropic uploads proposal text AND uploaded reference
# text to an external API; without this flag the app REFUSES TO START with
# that provider. This is the only gate that reaches the unattended claim-
# analysis ticks, which run with no request and no user to consent — the per-
# request disclosure gate cannot see them. Irrelevant to the default on-prem
# provider (ollama).
CITATION_LLM_ALLOW_CLOUD=false

# CITATION_LLM_MODEL (default: empty)
# Empty string = use the provider's default model (GEMMA_MODEL for ollama,
# REMOTE_RANK_MODEL for anthropic).
# CITATION_LLM_MODEL=

# CITATION_LLM_TIMEOUT_SECONDS (default: 60.0)
#
# CITATION_LLM_TIMEOUT_SECONDS=60.0

# CITATION_LLM_MAX_OUTPUT_TOKENS (default: 1024)
#
# CITATION_LLM_MAX_OUTPUT_TOKENS=1024

# CITATION_LLM_DAILY_TOKEN_CAP_INPUT (default: 200000)
#
# CITATION_LLM_DAILY_TOKEN_CAP_INPUT=200000

# CITATION_LLM_DAILY_TOKEN_CAP_OUTPUT (default: 50000)
#
# CITATION_LLM_DAILY_TOKEN_CAP_OUTPUT=50000

# GLOBAL_CITATION_LLM_DAILY_TOKEN_CAP_INPUT (default: 2000000)
#
# GLOBAL_CITATION_LLM_DAILY_TOKEN_CAP_INPUT=2000000

# GLOBAL_CITATION_LLM_DAILY_TOKEN_CAP_OUTPUT (default: 500000)
#
# GLOBAL_CITATION_LLM_DAILY_TOKEN_CAP_OUTPUT=500000

# REFERENCE_EXTRACT_TIMEOUT_SECONDS (default: 30.0)
# Hard wall-clock bound on untrusted file text-extraction. Extraction runs in
# a separate process that is terminated on timeout; the reference is then
# marked text_status='failed'. Guards the single app process against a
# pathological upload pinning the CPU.
# REFERENCE_EXTRACT_TIMEOUT_SECONDS=30.0

# REFERENCE_INGEST_CONCURRENCY (default: 3)
# Max concurrent reference ingests across upload/fetch/tool. Acquired before
# buffering the body; over-capacity uploads get 429.
# REFERENCE_INGEST_CONCURRENCY=3

# REFERENCE_MAX_BATCH_FILES (default: 25)
# Client-enforced max PDFs per drag-drop batch.
# REFERENCE_MAX_BATCH_FILES=25

# REFERENCE_MAX_BATCH_BYTES (default: 209715200)
# Client-enforced max total bytes per drag-drop batch.
# REFERENCE_MAX_BATCH_BYTES=209715200

# COMPACTION_TURN_THRESHOLD (default: 100)
# Number of un-summarized chat_turns since the latest chat_summaries row that
# triggers compaction.
# COMPACTION_TURN_THRESHOLD=100

# COMPACTION_TOKEN_THRESHOLD (default: 200000)
# Sum of input-tokens across un-summarized chat_turns that triggers compaction
# (whichever threshold trips first).
# COMPACTION_TOKEN_THRESHOLD=200000

# COMPACTION_TICK_SECONDS (default: 300)
# How often the compaction tick scans for workspaces over threshold.
# COMPACTION_TICK_SECONDS=300

# ANALYSIS_TICK_SECONDS (default: 20)
# Claim-analysis queue drain interval (seconds).
# ANALYSIS_TICK_SECONDS=20

# ANALYSIS_RECONCILE_TICK_SECONDS (default: 900)
# Claim-analysis coverage reconcile interval (seconds).
# ANALYSIS_RECONCILE_TICK_SECONDS=900

# TURN_DRAIN_TICK_SECONDS (default: 5)
# How often the turn-drain tick picks one queued turn per workspace and
# dispatches it. Lower = snappier perceived latency; higher = less polling
# overhead. B6's SSE bridge may add its own zero-latency wakeup so this is a
# floor, not the only mechanism.
# TURN_DRAIN_TICK_SECONDS=5

# TURN_MAX_SECONDS (default: 600)
# Hard wall-clock bound on a single turn's processing inside the drain tick. A
# turn that exceeds this is cancelled in-loop and finalized as failed,
# releasing the workspace's running-row cleanly. MUST stay comfortably below
# the reaper TTL (reaper.DEFAULT_REAP_TTL_SECONDS) so a slow-but-live turn is
# bounded by this clean path, not reaped while still streaming.
TURN_MAX_SECONDS=600

# REMOTE_RANK_MODEL (default: claude-sonnet-4-6)
#
REMOTE_RANK_MODEL=claude-sonnet-4-6

# RANKING_ESCALATION_MIN_SCORE (default: 45)
# Local aggregate score at/above which a pair re-runs on the remote model.
# Mirrors DIGEST_BORDERLINE_LOWER so every digest-worthy call gets the Sonnet
# second opinion + analysis.
# RANKING_ESCALATION_MIN_SCORE=45

# RANKING_REMOTE_DAILY_CAP (default: 100)
# Max remote escalation attempts per Europe/Stockholm day (counted from
# ranking_remote_attempts). Guardrail for backfill spikes.
# RANKING_REMOTE_DAILY_CAP=100

# EMAIL_TRANSPORT (default: empty)
# Explicit email transport: 'resend' or 'smtp'. Empty (the default) means
# INFER from whichever credential is set — resend first, then smtp — which is
# what create_app's sender selection already did. It used to default to
# 'resend', so an SMTP-only deploy built its alert sender fine and silently
# never scheduled the weekly digest. See
# email/factory.resolve_email_transport.
EMAIL_TRANSPORT=

# SMTP_HOST (default: empty)
#
SMTP_HOST=

# SMTP_PORT (default: 587)
#
SMTP_PORT=587

# SMTP_USER (default: empty)
#
SMTP_USER=

# SMTP_PASSWORD (default: empty)
#
SMTP_PASSWORD=

# SESSION_MAX_AGE_SECONDS (default: 2592000)
# Session cookie lifetime. 30 days by default; an organisational policy
# choice.
SESSION_MAX_AGE_SECONDS=2592000

# MAX_REQUEST_BODY_BYTES (default: 67108864)
#
MAX_REQUEST_BODY_BYTES=67108864

# DIGEST_DRY_RUN (default: false)
# Render the weekly digest without sending it. Set true in development.
DIGEST_DRY_RUN=false

# ADMIN_DASHBOARD_URL (default: http://localhost:8000/)
# Public URL of the dashboard; EVERY link in the weekly digest email is built
# from it. The default points at localhost, so a production deployment must
# set it.
ADMIN_DASHBOARD_URL=https://calls.example.org/

# SPA_MODE (default: disabled)
# How the React SPA is served. prod = FastAPI serves the built bundle (the
# only production value; a built SPA must ship); dev = Vite dev server on
# :5173 proxies the API; disabled = API only, no UI at all. There is no safe
# default.
SPA_MODE=prod

# LOG_LEVEL (default: INFO)
# Root log level (DEBUG, INFO, WARNING, ERROR). APScheduler's own logger is
# held at WARNING regardless — its per-job INFO lines were 32 MB/day.
LOG_LEVEL=INFO
