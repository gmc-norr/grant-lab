# .env.example — GENERATED from src/grant_lab/config.py by
# scripts/gen_env_example.py. Do not hand-edit: regenerate with
#     uv run python scripts/gen_env_example.py
# and tests/test_env_example.py fails while this file is stale.
#
# Copy to .env. Lines that are NOT commented out are the day-one decisions
# (required values, and defaults a real deployment must confirm); commented
# lines show the code default and can be left alone. Every setting the app
# reads is listed, in the order config.py declares it.


# DATABASE_URL (REQUIRED)
# SQLAlchemy URL of the Postgres 16 database (psycopg driver), e.g.
# postgresql+psycopg://call_manager:PASSWORD@localhost:5432/call_manager.
# Alembic reads the same value (alembic/env.py falls back to this file).
DATABASE_URL=postgresql+psycopg://call_manager:CHANGE_ME@localhost:5432/call_manager

# SESSION_SECRET (REQUIRED)
# Signing key for the session cookie. Generate one: python -c "import secrets;
# print(secrets.token_urlsafe(48))". Left blank in the example on purpose so a
# copied file cannot ship a known key. A real deployment (an https://
# APP_BASE_URL, or SPA_MODE=prod) refuses to start unless it is >= 32 chars
# and not a known dev placeholder.
SESSION_SECRET=

# ALLOWED_EMAIL_DOMAINS (REQUIRED)
# Comma-separated email domains allowed to sign in or request access. Checked
# at registration, every sign-in and every request: a member whose domain is
# removed loses access at once. Administrators are exempt, except at Google
# sign-in, which also creates accounts.
ALLOWED_EMAIL_DOMAINS=regionvasterbotten.se,umu.se

# INITIAL_ADMIN_EMAIL (default: empty)
# Comma-separated admin emails created at startup. Lockout recovery: when NO
# active admin exists, these are re-activated and re-promoted at startup —
# otherwise an existing user is left exactly as it is. To permanently demote
# one, remove it from this list first.
INITIAL_ADMIN_EMAIL=

# INITIAL_ADMIN_PASSWORD (default: empty)
# Password for a configured admin that does NOT have one yet (first boot, or
# an admin restored from total lockout). Must be >= 12 chars; empty = unset.
# Choose your own: a value this project has published (the old README example)
# is refused. It never overwrites an existing password hash
# (admin_bootstrap.py): a restart with this set does not reset a forgotten or
# compromised admin password — use the in-app admin reset, which needs a
# second admin. Unset it once logged in so the value stops living in a file.
# INITIAL_ADMIN_PASSWORD=

# APP_BASE_URL (REQUIRED)
# The origin browsers use, scheme included, no path. It is what the CSRF
# origin check compares against, so in SPA_MODE=dev it is the Vite origin
# (http://localhost:5173). https:// turns on Secure cookies and HSTS, refuses
# SPA_MODE=dev, and requires TRUSTED_PROXY to be stated.
APP_BASE_URL=https://calls.example.org

# GOOGLE_OIDC_ENABLED (default: false)
#
# GOOGLE_OIDC_ENABLED=false

# GOOGLE_CLIENT_ID (default: empty)
#
# GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET (default: empty)
#
# GOOGLE_CLIENT_SECRET=

# GOOGLE_OIDC_DISCOVERY_URL (default: https://accounts.google.com/.well-known/openid-configuration)
#
# GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# RESEND_API_KEY (default: empty)
#
RESEND_API_KEY=

# EMAIL_FROM (default: no-reply@example.com)
#
EMAIL_FROM=no-reply@example.com

# TRUSTED_PROXY (default: false)
# Whether a reverse proxy sits between browsers and the app. true: read the
# client address from X-Forwarded-For (the proxy must overwrite it; see
# TRUSTED_PROXY_HOPS). false: browsers connect directly. Blank means not
# answered: fine over plain http, where it is read as false, but with an
# https:// APP_BASE_URL the app refuses to start until you answer, because the
# wrong answer behind a proxy puts every visitor in one rate-limit bucket and
# 30 requests lock everybody out.
TRUSTED_PROXY=

# TRUSTED_PROXY_HOPS (default: 1)
#
TRUSTED_PROXY_HOPS=1

# EU_PORTAL_BASE_URL (default: https://api.tech.ec.europa.eu)
#
# EU_PORTAL_BASE_URL=https://api.tech.ec.europa.eu

# VINNOVA_BASE_URL (default: https://data.vinnova.se)
#
# VINNOVA_BASE_URL=https://data.vinnova.se

# ADMIN_ALERT_EMAIL (default: empty)
#
ADMIN_ALERT_EMAIL=

# STALE_SOURCE_ALERT_DAYS (default: 4)
# A source whose last_fetched_at is older than this many days triggers a
# stale-fetch alert regardless of the consecutive-failure streak state. Acts
# as a restart-independent backstop: catches sources that silently stop being
# fetched (e.g. scheduler crash within the 3-day streak window). Default 4
# gives one full day of slack beyond the 3-day streak threshold.
STALE_SOURCE_ALERT_DAYS=4

# RANKING_TICK_SECONDS (default: 60)
#
# RANKING_TICK_SECONDS=60

# RANKING_QUEUE_BATCH (default: 10)
#
# RANKING_QUEUE_BATCH=10

# RANKING_TICK_BUDGET_SECONDS (default: 240.0)
#
# RANKING_TICK_BUDGET_SECONDS=240.0

# OLLAMA_URL (default: http://localhost:11434)
#
OLLAMA_URL=http://localhost:11434

# GEMMA_MODEL (default: gemma4:e4b-it-q4_K_M)
#
GEMMA_MODEL=gemma4:e4b-it-q4_K_M

# EMBEDDING_MODEL (default: bge-m3)
# Ollama embedding model (1024-dim). Must match what Ollama has pulled; the
# similarity thresholds are calibrated for bge-m3.
EMBEDDING_MODEL=bge-m3

# EMBEDDING_DIM (default: 1024)
#
# EMBEDDING_DIM=1024

# EMBEDDING_PREGATE_THRESHOLD (default: 0.3)
#
# EMBEDDING_PREGATE_THRESHOLD=0.3

# EMBEDDING_HARD_FAIL_THRESHOLD (default: 0.2)
#
# EMBEDDING_HARD_FAIL_THRESHOLD=0.2

# ANTHROPIC_API_KEY (default: empty)
#
ANTHROPIC_API_KEY=

# PROFILE_BOOTSTRAP_TICK_SECONDS (default: 30)
# How often the in-process profile bootstrap worker drains
# profile_bootstrap_jobs. Lowering this shortens the gap between profile
# creation and LLM draft completion; raising it reduces idle DB churn when the
# queue is empty.
# PROFILE_BOOTSTRAP_TICK_SECONDS=30

# SCHEDULER_STANDBY_OK (default: false)
# This app is single-instance: the in-process scheduler and the login limiters
# are per-process state. When another process already holds the single-
# instance advisory lock, startup is FATAL by default. Set true to boot an
# HTTP-only standby instead: it serves requests, runs no scheduler, and
# /healthz answers 200 with scheduler_lock=false. Without this flag a process
# that does not hold the lock answers /healthz 503.
# SCHEDULER_STANDBY_OK=false

# REMOTE_RANK_MODEL (default: claude-sonnet-5-5)
#
REMOTE_RANK_MODEL=claude-sonnet-5-5

# REMOTE_RANK_EFFORT (default: high)
# Anthropic `output_config.effort` for the remote ranker. `high` is what
# claude-sonnet-5-5 does when none is sent, so the default changes nothing; it
# is pinned so a REMOTE_RANK_MODEL swap cannot silently change thinking depth
# (claude-opus-5-5 defaults to medium). Effort is NOT in the scoring
# fingerprint (the remote model is not either), so changing it re-ranks
# nothing already stored. Lower it only after measuring against labels.
# REMOTE_RANK_EFFORT=high

# RANKING_ESCALATION_MIN_SCORE (default: 45)
# Local aggregate score at/above which a pair re-runs on the remote model. NOT
# the digest threshold: DIGEST_BORDERLINE_LOWER is 40, so a call scoring 40-44
# reaches the digest with local scores only. Lower this to cover more of the
# digest's borderline band, at hosted cost and against the daily escalation
# cap.
# RANKING_ESCALATION_MIN_SCORE=45

# RANKING_LOGPROBS_ENABLED (default: false)
# Ask the local ranker for per-token logprobs so ranking/ev.py can replace the
# integer topic_fit rating with a probability-weighted expected value, un-
# quantising aggregate_score from multiples of 20. OFF by default because it
# is measured at ~6x the wall-clock cost (127s vs 21s per ranking on
# gemma4:e4b-it-q4_K_M, 8000-char call, idle 2080 Ti: the response grows from
# 6KB to 1.2MB) while buying under 3 points of score movement at temperature 0
# — far too little to cross RANKING_ESCALATION_MIN_SCORE, which sits 5 points
# from the nearest reachable score. Turn ON for a model whose rating
# distribution is less peaked, or if the temperature is raised.
# RANKING_LOGPROBS_ENABLED=false

# RANKING_REMOTE_DAILY_CAP (default: 300)
# Max remote escalation attempts per Europe/Stockholm day (counted from
# ranking_remote_attempts). Guardrail for backfill spikes. Raised 100 -> 150
# on 2026-09-09 when REMOTE_RANK_MODEL moved from claude-sonnet-4-6 ($3/$15
# per MTok) to claude-sonnet-5 ($2/$10) -- the 2/3 price ratio makes 150
# escalations cost what 100 did, so this is a cost-neutral raise, not a budget
# increase. It was chosen because the cap was being HIT: on 2026-09-09, 33
# pairs scoring >= RANKING_ESCALATION_MIN_SCORE were denied escalation after
# the 100th attempt and shipped with a Gemma-only score and no analysis.
# Raised 150 -> 300 on 2026-10-05: since ranking freshness (2026-09-24) a day
# uses 0-27 attempts (09-25..10-04), so the cap binds only on a full re-rank,
# and 150 split the 09-24 re-rank (223 attempts that day) over two days.
# RANKING_REMOTE_DAILY_CAP=300

# EMAIL_TRANSPORT (default: empty)
# Explicit email transport: 'resend' or 'smtp'. Empty (the default) means
# INFER from whichever credential is set — resend first, then smtp — which is
# what create_app's sender selection already did. It used to default to
# 'resend', so an SMTP-only deploy built its alert sender fine and silently
# never scheduled the weekly digest. See
# email/factory.resolve_email_transport.
EMAIL_TRANSPORT=

# SMTP_HOST (default: empty)
#
SMTP_HOST=

# SMTP_PORT (default: 587)
#
SMTP_PORT=587

# SMTP_USER (default: empty)
#
SMTP_USER=

# SMTP_PASSWORD (default: empty)
#
SMTP_PASSWORD=

# SESSION_MAX_AGE_SECONDS (default: 2592000)
# Session cookie lifetime. 30 days by default; an organisational policy
# choice.
SESSION_MAX_AGE_SECONDS=2592000

# MAX_REQUEST_BODY_BYTES (default: 67108864)
#
MAX_REQUEST_BODY_BYTES=67108864

# DIGEST_DRY_RUN (default: false)
# Render the weekly digest without sending it. Set true in development.
DIGEST_DRY_RUN=false

# ADMIN_DASHBOARD_URL (default: http://localhost:8000/)
# Public URL of the dashboard; EVERY link in the weekly digest email is built
# from it. The default points at localhost, so a production deployment must
# set it.
ADMIN_DASHBOARD_URL=https://calls.example.org/

# SPA_MODE (default: disabled)
# How the React SPA is served. prod = FastAPI serves the built bundle (the
# only production value; a built SPA must ship, and the production
# SESSION_SECRET rules apply even over plain http); dev = Vite dev server on
# :5173 proxies the API (refused with an https:// APP_BASE_URL); disabled =
# API only, no UI at all. There is no safe default.
SPA_MODE=prod

# LOG_LEVEL (default: INFO)
# Root log level (DEBUG, INFO, WARNING, ERROR). APScheduler's own logger is
# held at WARNING regardless — its per-job INFO lines were 32 MB/day.
LOG_LEVEL=INFO
