# .dockerignore — keep the SPA build context minimal AND secretless.
# The build container (frontend/Dockerfile) only needs frontend/ (source +
# lockfiles); everything else is excluded so no secrets, tenant data, or the
# Python venv ever enter the build image.

# VCS + worktrees
.git
.gitignore
.worktrees

# Python venv, build outputs, caches (large; never needed for the JS build)
.venv
dist
*.egg-info
**/__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache

# Node deps + outputs (installed fresh inside the container from the lockfile)
**/node_modules
frontend/dist

# Container-emitted SPA bundle (an OUTPUT, not an input)
src/grant_lab/web/spa

# Secrets / confidential tenant data — MUST NOT enter the build context.
# Docker matches a bare pattern at the context ROOT only, and
# frontend/Dockerfile copies frontend/ whole, so every secret pattern needs
# `**/` (security review 2026-10-31 S5: frontend/.env* reached the builder
# image). Pinned by tests/test_secret_file_exclusion.py with a real build.
var
data
**/*.env
**/.env*
**/api_key.txt
.claude
