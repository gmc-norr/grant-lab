{
  "name": "grant-lab-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "../scripts/package_spa.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings src e2e",
    "gen:api": "bash ../scripts/gen_openapi_types.sh",
    "e2e:match": "E2E_MODE=match playwright test e2e/match.spec.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@tanstack/react-query": "5.107.1",
    "@vscode/codicons": "0.0.45",
    "ics": "3.12.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "2.0.5",
    "jsdom": "24.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.93.0",
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vitest": "2.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
