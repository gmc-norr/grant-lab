{
  "name": "grant-lab-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:match": "VITE_APP_EDITION=match tsc && VITE_APP_EDITION=match vite build",
    "check:bundle": "node ../scripts/check_match_bundle.mjs dist",
    "package:match": "VITE_APP_EDITION=match ../scripts/package_spa.sh",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src e2e",
    "gen:api": "bash ../scripts/gen_openapi_types.sh",
    "e2e:match": "E2E_MODE=match playwright test e2e/match.spec.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/noto-sans": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@tanstack/react-query": "5.104.5",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@uiw/codemirror-theme-vscode": "4.25.12",
    "@vscode/codicons": "0.0.45",
    "ics": "3.12.1",
    "lib0": "0.2.119",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "2.1.9",
    "react-router-dom": "7.18.4",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.3.1",
    "jsdom": "24.1.1",
    "markdown-it": "14.2.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.89.0",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vitest": "2.0.5",
    "ws": "8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
