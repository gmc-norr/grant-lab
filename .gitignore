# Worktrees — isolated workspaces per feature/plan (see CLAUDE.md)
.worktrees/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage.json
.coverage
.coverage.*
frontend/coverage/

# Environment: every dotenv variant, at any depth (.env.local, .env.production,
# timestamped .env.bak-* backups all carry the same secrets as .env). The
# committed examples hold no values. Pinned by tests/test_secret_file_exclusion.py.
.env
.env.*
*.env
!.env.example

# Claude Code per-project config (per-user; share opt-in via `git add -f`)
.claude/

# Locally-rendered exports of design specs / plans
docs/**/*.pdf
# README.pdf is a 142 KB rendered copy of README.md — a build artifact, and it was
# tracked while every other generated PDF was ignored (review 2026-09-02 §12).
README.pdf

# Runtime data (e.g. golden_set_last.json written by weekly eval job)
data/

# Per-workspace git repos + uploaded attachments (WORKSPACES_DIR default is
# var/workspaces). Holds confidential proposal drafts and tenant uploads —
# never commit. In production point WORKSPACES_DIR outside the repo entirely.
var/

# OS
.DS_Store
Thumbs.db
.superpowers/
api_key.txt

# Frontend (React SPA, Plan 2): deps + build outputs. The container-emitted SPA
# bundle (src/grant_lab/web/spa/) is gitignored too — it is built by the
# secretless container (Task 6) and packaged via hatch `artifacts`, never committed.
frontend/node_modules
frontend/dist/
src/grant_lab/web/spa/
# Playwright e2e outputs (Plan 3 Task 9; the dual-mode run is deferred but these
# dirs appear the moment it runs locally or in CI — never commit them).
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# collab e2e runner transient log
.e2e-vite.log

# local uvicorn log from the run skill (transient, like .e2e-vite.log above)
app.log

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

jev_api.txt


# OSV-Scanner input: a requirements.txt projection of uv.lock, generated by the
# CI step (`uv export --frozen`) because osv-scanner 1.9.2 has no uv extractor.
# NEVER commit it — a checked-in export is a second lockfile that drifts from
# uv.lock silently. Regenerate locally with:
#     uv export --frozen --no-hashes --format requirements-txt > requirements-osv.txt
requirements-osv.txt
