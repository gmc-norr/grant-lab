# Worktrees — isolated workspaces per feature/plan (see CLAUDE.md)
.worktrees/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment
.env
.env.local

# Claude Code per-project config (per-user; share opt-in via `git add -f`)
.claude/

# Locally-rendered exports of design specs / plans
docs/**/*.pdf

# Runtime data (e.g. golden_set_last.json written by weekly eval job)
data/

# Per-workspace git repos + uploaded attachments (WORKSPACES_DIR default is
# var/workspaces). Holds confidential proposal drafts and tenant uploads —
# never commit. In production point WORKSPACES_DIR outside the repo entirely.
var/

# OS
.DS_Store
Thumbs.db
.superpowers/
api_key.txt

# Frontend (React SPA, Plan 2): deps + build outputs. The container-emitted SPA
# bundle (src/call_manager/web/spa/) is gitignored too — it is built by the
# secretless container (Task 6) and packaged via hatch `artifacts`, never committed.
frontend/node_modules
frontend/dist/
src/call_manager/web/spa/
# Playwright e2e outputs (Plan 3 Task 9; the dual-mode run is deferred but these
# dirs appear the moment it runs locally or in CI — never commit them).
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# collab e2e runner transient log
.e2e-vite.log

# local uvicorn log from the run skill (transient, like .e2e-vite.log above)
app.log
